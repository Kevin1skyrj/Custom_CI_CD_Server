PORT=3000
GITHUB_WEBHOOK_SECRET=replace-with-a-random-secret
ALLOWED_REPOSITORY=Kevin1skyrj/DataDock
ALLOWED_BRANCH=main

PIPELINE_DATA_DIR=/var/lib/custom-cicd/pipeline-jobs
PIPELINE_WORKSPACE_DIR=/var/lib/custom-cicd/workspaces
PIPELINE_EXECUTION_ENABLED=true
REPOSITORY_CLONE_URL=https://github.com/Kevin1skyrj/DataDock.git
DATADOCK_CLIENT_BUILD_ENV_FILE=/etc/custom-cicd/datadock-client-build.env

DEPLOYMENT_TYPE=ssh
LOCAL_DEPLOY_DIR=/var/lib/custom-cicd/local-staging

SSH_HOST=172.31.9.177
SSH_USER=ubuntu
SSH_PORT=22
SSH_PRIVATE_KEY_PATH=/etc/custom-cicd/keys/datadock-deploy
SSH_KNOWN_HOSTS_FILE=/etc/custom-cicd/ssh/known_hosts
SSH_REMOTE_DEPLOY_DIR=/var/www/datadock-deploy/releases
SSH_REMOTE_DEPLOY_SCRIPT=/usr/local/bin/cicd-deploy
SSH_TIMEOUT_MS=300000

DEPLOY_HOOK_URL=
DEPLOY_HOOK_ROLLBACK_URL=
DEPLOY_HOOK_TIMEOUT_MS=10000

S3_BUCKET=
S3_REGION=ap-south-1
S3_BUILD_DIR=client/out
S3_PREFIX=staging

HEALTH_CHECK_URL=https://api.datadock.me/health
HEALTH_CHECK_ATTEMPTS=5
HEALTH_CHECK_INTERVAL_MS=5000
HEALTH_CHECK_TIMEOUT_MS=5000
ROLLBACK_ENABLED=true

EMAIL_NOTIFICATIONS_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=
