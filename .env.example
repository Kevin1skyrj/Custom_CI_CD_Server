PORT=3000
GITHUB_WEBHOOK_SECRET=replace-with-a-random-secret
ALLOWED_REPOSITORY=owner/repository
ALLOWED_BRANCH=main

PIPELINE_DATA_DIR=./data/pipeline-jobs
PIPELINE_WORKSPACE_DIR=./data/workspaces
PIPELINE_EXECUTION_ENABLED=true
REPOSITORY_CLONE_URL=https://github.com/owner/repository.git
DATADOCK_CLIENT_BUILD_ENV_FILE=

DEPLOYMENT_TYPE=local
LOCAL_DEPLOY_DIR=./data/local-releases

SSH_HOST=app.example.internal
SSH_USER=cicd-deploy
SSH_PORT=22
SSH_PRIVATE_KEY_PATH=/path/to/deployment-key
SSH_KNOWN_HOSTS_FILE=/path/to/known_hosts
SSH_REMOTE_DEPLOY_DIR=/var/www/application/releases
SSH_REMOTE_DEPLOY_SCRIPT=/usr/local/bin/cicd-deploy
SSH_TIMEOUT_MS=300000

DEPLOY_HOOK_URL=
DEPLOY_HOOK_ROLLBACK_URL=
DEPLOY_HOOK_TIMEOUT_MS=10000

S3_BUCKET=
S3_REGION=ap-south-1
S3_BUILD_DIR=client/out
S3_PREFIX=staging

HEALTH_CHECK_URL=https://app.example.com/health
HEALTH_CHECK_ATTEMPTS=5
HEALTH_CHECK_INTERVAL_MS=5000
HEALTH_CHECK_TIMEOUT_MS=5000
ROLLBACK_ENABLED=true

EMAIL_NOTIFICATIONS_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=
